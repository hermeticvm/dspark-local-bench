{
  "description": "Qwen3-8B Q4_K_M for 8 GB GPUs (7.1 GB of VRAM measured with the DSpark drafter and 4k context): the key settings from qwen3-8b.json. About 25 min on a ~60 t/s GPU.",
  "target": "models/Qwen3-8B-Q4_K_M.gguf",
  "context": 4096,
  "chat_template_kwargs": {"enable_thinking": false},
  "bench": {
    "bench": "qualitative",
    "categories": "coding,math,writing,qa",
    "limit": 8,
    "osl": 512,
    "extra_inputs": {"temperature": 0}
  },
  "downloads": [
    {"repo": "Qwen/Qwen3-8B-GGUF", "file": "Qwen3-8B-Q4_K_M.gguf"},
    {"repo": "ggml-org/Qwen3-8B-GGUF", "file": "dspark-Qwen3-8B-Q8_0.gguf"},
    {"repo": "ggml-org/Qwen3-8B-GGUF", "file": "dflash-Qwen3-8B-Q8_0.gguf"},
    {"repo": "Qwen/Qwen3-0.6B-GGUF", "file": "Qwen3-0.6B-Q8_0.gguf"}
  ],
  "runs": [
    {"id": "baseline"},
    {
      "id": "draft-simple-n3",
      "draft": "models/Qwen3-0.6B-Q8_0.gguf",
      "args": ["--spec-type", "draft-simple", "--spec-draft-n-max", "3"]
    },
    {
      "id": "dflash-n4",
      "draft": "models/dflash-Qwen3-8B-Q8_0.gguf",
      "args": ["--spec-type", "draft-dflash", "--spec-draft-n-max", "4"]
    },
    {
      "id": "dspark-n{n}-p0",
      "draft": "models/dspark-Qwen3-8B-Q8_0.gguf",
      "args": ["--spec-type", "draft-dspark", "--spec-draft-n-max", "{n}", "--spec-draft-p-min", "0"],
      "sweep": {"n": [3, 5, 7]}
    },
    {
      "id": "dspark-n3-p0.3",
      "draft": "models/dspark-Qwen3-8B-Q8_0.gguf",
      "args": ["--spec-type", "draft-dspark", "--spec-draft-n-max", "3", "--spec-draft-p-min", "0.3"]
    }
  ]
}
